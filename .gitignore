
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# VS Code local settings
.vscode/

# IDE files
.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Environment and local secrets
.env
.env.*
!.env.example
*.log

# ==========================================
